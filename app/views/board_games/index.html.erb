<h1 style="text-align: center; margin-bottom: 20px; color: #e91e63; font-family: Georgia, serif;">Board Game Library</h1>

<table style="width: 80%; margin: auto; border-collapse: collapse; font-size: 18px; background-color: #ffe6f0; font-family: Georgia, serif;">
  <thead>
    <tr style="background-color: #f8bbd0;">
      <th style="border: 1px solid #e91e63; padding: 12px;">Title</th>
      <th style="border: 1px solid #e91e63; padding: 12px;">Category</th>
      <th style="border: 1px solid #e91e63; padding: 12px;">Players</th>
      <th style="border: 1px solid #e91e63; padding: 12px;">Publisher</th>
    </tr>
  </thead>
  <tbody>
    <% @board_games.each do |game| %>
      <tr style="text-align: center;">
        <td style="border: 1px solid #e91e63; padding: 12px;">
          <%= link_to game.title, board_game_path(game), style: "color: #d81b60; text-decoration: none;" %>
        </td>
        <td style="border: 1px solid #e91e63; padding: 12px;"><%= game.category %></td>
        <td style="border: 1px solid #e91e63; padding: 12px;"><%= game.min_players %> - <%= game.max_players %> players</td>
        <td style="border: 1px solid #e91e63; padding: 12px;"><%= game.publisher %></td>
      </tr>
    <% end %>
  </tbody>
</table>
